#!/bin/bash -p
# Print a compact, public diagnostic summary.
set -Eeuo pipefail

PATH="/usr/bin:/bin:/usr/sbin:/sbin"
export PATH

safe_security_mode() {
  case "${TAIJI_SECURITY_MODE:-restricted}" in
    restricted|full) printf '%s' "${TAIJI_SECURITY_MODE:-restricted}" ;;
    *) printf '%s' 'restricted' ;;
  esac
}

package_status() {
  local status
  if ! command -v dpkg-query >/dev/null 2>&1; then
    printf '%s' 'unavailable'
    return
  fi
  status="$(dpkg-query -W -f='${db:Status-Status}' taiji-agent 2>/dev/null || true)"
  case "$status" in
    installed|config-files|unpacked|half-configured) printf '%s' "$status" ;;
    *) printf '%s' 'not-installed' ;;
  esac
}

architecture() {
  case "$(uname -m 2>/dev/null || true)" in
    x86_64|amd64) printf '%s' 'amd64' ;;
    *) printf '%s' 'unsupported' ;;
  esac
}

print_security_report() {
  printf '%s\n' 'security.schema=taiji-agent-diagnose-security/v1'
  printf 'security.profile=%s\n' "$(safe_security_mode)"
  printf '%s\n' 'effective_security_profile=restricted'
  printf '%s\n' 'approval_applicable.terminal=false'
  printf '%s\n' 'document_read.native=unknown'
  printf '%s\n' 'taiji_tmp_policy=managed'
}

print_allowlist_report() {
  printf '%s\n' 'allowlist.schema=taiji-agent-diagnose-allowlist/v1'
  printf '%s\n' 'allowlist.status=not-collected'
  printf '%s\n' 'allowlist.scope=public-fields-only'
}

print_summary() {
  printf '%s\n' 'schema=taiji-agent-diagnose/v2'
  printf '%s\n' 'product=taiji-agent'
  printf 'architecture=%s\n' "$(architecture)"
  printf 'package.status=%s\n' "$(package_status)"
  printf '%s\n' 'runtime.source=installed-payload'
  printf '%s\n' 'runtime.mode=system-only'
  printf '%s\n' 'network.mode=offline-safe'
  print_security_report
  print_allowlist_report
}

case "${1:-}" in
  --security)
    print_security_report
    ;;
  --allowlist)
    print_allowlist_report
    ;;
  --help|-h)
    printf '%s\n' 'Usage: taiji-agent-diagnose [--security|--allowlist]'
    ;;
  *)
    print_summary
    ;;
esac
