{
  "id": "standalone-office-material",
  "name": "单机版办公材料模板",
  "version": "1.0.0",
  "description": "面向通知、方案、总结计划和材料润色的本地通用模板，仅承载用户确认内容。",
  "template": "template.docx",
  "schema": "schema.json",
  "prompt": "prompt.md",
  "sample": "sample.json",
  "dataAdapter": "data-adapter.js",
  "adapterSample": "adapter-sample.render-plan.json",
  "outputFormat": "docx",
  "documentTypes": ["notice", "plan", "summary_plan", "other_office_material"],
  "contractProfile": "standalone",
  "rendererProfile": "standalone-default",
  "requiredMetadata": ["title", "documentType"],
  "contentPolicy": {
    "allowAdapterGeneratedBusinessContent": false,
    "allowPlaceholders": false
  },
  "missingDataPolicy": {
    "markers": ["待补充", "需人工确认"],
    "forbidFabrication": true
  },
  "capabilities": ["sections", "tables", "images", "toc", "headers", "footers", "page_numbers"],
  "requiredAssets": [],
  "qualityGates": ["schema_valid", "docx_zip", "docx_xml", "missing_data_markers", "file_integrity"],
  "compatibility": {
    "engine": "docx-engine-v2",
    "minVersion": "0.1.0",
    "format": "docx",
    "paper": "A4"
  }
}
