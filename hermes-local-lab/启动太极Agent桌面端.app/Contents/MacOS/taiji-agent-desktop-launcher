#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
LAB_DIR="$(cd "$SCRIPT_DIR/../../.." && pwd -P)"
COMMAND_LAUNCHER="$LAB_DIR/启动太极Agent桌面端.command"

show_error() {
  local message="$1"
  local escaped
  escaped="$(printf '%s' "$message" | sed 's/\\/\\\\/g; s/"/\\"/g')"
  /usr/bin/osascript -e "display dialog \"$escaped\" with title \"太极 Agent 启动失败\" buttons {\"好\"} default button \"好\"" >/dev/null 2>&1 || true
}

if [ ! -x "$COMMAND_LAUNCHER" ]; then
  show_error "未找到可执行的源码启动脚本，请查看当前 worktree。"
  exit 1
fi

if ! /usr/bin/open -a Terminal "$COMMAND_LAUNCHER"; then
  show_error "无法通过终端启动太极 Agent，请查看本地日志。"
  exit 1
fi

exit 0
