#!/bin/bash -p
set -euo pipefail

PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
unset BASH_ENV ENV CDPATH GLOBIGNORE LD_PRELOAD LD_LIBRARY_PATH PYTHONPATH PYTHONHOME NODE_OPTIONS NODE_PATH ELECTRON_RUN_AS_NODE || true

TAIJI_POLICY_ID=@@TAIJI_POLICY_ID@@
TAIJI_POLICY_SHA256=@@TAIJI_POLICY_SHA256@@
TAIJI_PACKAGE_NAME=@@TAIJI_PACKAGE_NAME@@
TAIJI_INSTALL_ROOT=@@TAIJI_INSTALL_ROOT@@
TAIJI_UNAME_ARCH=@@TAIJI_UNAME_ARCH@@
TAIJI_DPKG_ARCH=@@TAIJI_DPKG_ARCH@@
TAIJI_OS_IDS=@@TAIJI_OS_IDS@@
TAIJI_GLIBC_MIN=@@TAIJI_GLIBC_MIN@@
TAIJI_KERNEL_MIN=@@TAIJI_KERNEL_MIN@@
TAIJI_COMMANDS=@@TAIJI_COMMANDS@@
TAIJI_DESKTOP_DIRS=@@TAIJI_DESKTOP_DIRS@@
TAIJI_LOOPBACK_PATH=@@TAIJI_LOOPBACK_PATH@@
TAIJI_INSTALL_ROOT_PARENT=@@TAIJI_INSTALL_ROOT_PARENT@@
TAIJI_DISK_HEADROOM_MIB=@@TAIJI_DISK_HEADROOM_MIB@@

TAIJI_PREFLIGHT_ERROR_CODE=""
TAIJI_PREFLIGHT_REASON_ZH=""
TAIJI_PREFLIGHT_FAILED_CAPABILITIES=()

preflight_block() {
  local code="$1"
  local reason="$2"
  local existing=""
  if [ "${#TAIJI_PREFLIGHT_FAILED_CAPABILITIES[@]}" -gt 0 ]; then
    for existing in "${TAIJI_PREFLIGHT_FAILED_CAPABILITIES[@]}"; do
      [ "$existing" = "$code" ] && return 0
    done
  fi
  if [ -z "$TAIJI_PREFLIGHT_ERROR_CODE" ]; then
    TAIJI_PREFLIGHT_ERROR_CODE="$code"
    TAIJI_PREFLIGHT_REASON_ZH="$reason"
  fi
  TAIJI_PREFLIGHT_FAILED_CAPABILITIES+=("$code")
}

trusted_stat_metadata() {
  local path="$1"
  local dereference="${2:-0}"
  local metadata=""
  if [ "$dereference" = "1" ]; then
    metadata="$(stat -Lc '%u:%a:%h' -- "$path" 2>/dev/null)" \
      || metadata="$(stat -L -f '%u:%Lp:%l' -- "$path" 2>/dev/null)" \
      || return 1
  else
    metadata="$(stat -c '%u:%a:%h' -- "$path" 2>/dev/null)" \
      || metadata="$(stat -f '%u:%Lp:%l' -- "$path" 2>/dev/null)" \
      || return 1
  fi
  printf '%s' "$metadata"
}

root_path() {
  local root_prefix="$1"
  local path="$2"
  if [ "$root_prefix" = "/" ]; then
    printf '%s' "$path"
  elif [ "$path" = "$root_prefix" ] || [[ "$path" == "$root_prefix"/* ]]; then
    printf '%s' "$path"
  elif [[ "$path" == /* ]]; then
    printf '%s%s' "$root_prefix" "$path"
  else
    printf '%s/%s' "${root_prefix%/}" "$path"
  fi
}

resolve_trusted_os_release() {
  local os_release_file="$1"
  local root_prefix="$2"
  local expected_owner_uid="$3"
  local candidate=""
  local trusted_usr_lib_file="$(root_path "$root_prefix" /usr/lib/os-release)"
  local metadata="" owner="" mode="" link_count=""
  local link_value="" linked_path="" resolved_path="" trusted_path=""

  [ -e "$os_release_file" ] || [ -L "$os_release_file" ] || return 1
  if [ -L "$os_release_file" ]; then
    metadata="$(trusted_stat_metadata "$os_release_file" 0)" || return 1
    IFS=: read -r owner mode link_count <<< "$metadata"
    [ "$owner" = "$expected_owner_uid" ] || return 1
    [ "$link_count" = "1" ] || return 1
    link_value="$(readlink "$os_release_file" 2>/dev/null)" || return 1
    case "$link_value" in
      /*) linked_path="$(root_path "$root_prefix" "$link_value")" ;;
      *) linked_path="$(dirname "$os_release_file")/$link_value" ;;
    esac
    resolved_path="$(cd "$(dirname "$linked_path")" 2>/dev/null && pwd -P)" || return 1
    resolved_path="$resolved_path/$(basename "$linked_path")"
    trusted_path="$(cd "$(dirname "$trusted_usr_lib_file")" 2>/dev/null && pwd -P)" || return 1
    trusted_path="$trusted_path/$(basename "$trusted_usr_lib_file")"
    [ "$resolved_path" = "$trusted_path" ] || return 1
    candidate="$trusted_usr_lib_file"
  else
    candidate="$os_release_file"
  fi

  [ -f "$candidate" ] && [ ! -L "$candidate" ] || return 1
  metadata="$(trusted_stat_metadata "$candidate" 1)" || return 1
  IFS=: read -r owner mode link_count <<< "$metadata"
  [ "$owner" = "$expected_owner_uid" ] || return 1
  [[ "$mode" =~ ^[0-7]{3,4}$ ]] || return 1
  if (( (8#$mode & 8#22) != 0 )); then
    return 1
  fi
  [ "$link_count" = "1" ] || return 1
  printf '%s' "$candidate"
}

read_os_release_id() {
  local os_release_file="$1"
  local root_prefix="$2"
  local expected_owner_uid="$3"
  local trusted_file=""
  local raw=""
  trusted_file="$(resolve_trusted_os_release "$os_release_file" "$root_prefix" "$expected_owner_uid")" || return 1
  raw="$(awk -F= '$1 == "ID" {print substr($0, length($1) + 2); exit}' "$trusted_file" 2>/dev/null)" || return 1
  case "$raw" in
    \"*\") raw="${raw:1:${#raw}-2}" ;;
    \'*\') raw="${raw:1:${#raw}-2}" ;;
  esac
  [[ "$raw" =~ ^[A-Za-z0-9][A-Za-z0-9._+-]*$ ]] || return 1
  printf '%s' "$raw"
}

numeric_version_ge() {
  local actual="$1"
  local minimum="$2"
  local IFS=.
  local -a actual_parts=()
  local -a minimum_parts=()
  local count index actual_part minimum_part
  actual="${actual%%[-+[:space:]]*}"
  minimum="${minimum%%[-+[:space:]]*}"
  [[ "$actual" =~ ^[0-9]+(\.[0-9]+)+$ ]] || return 1
  [[ "$minimum" =~ ^[0-9]+(\.[0-9]+)+$ ]] || return 1
  read -r -a actual_parts <<< "$actual"
  read -r -a minimum_parts <<< "$minimum"
  count="${#actual_parts[@]}"
  if [ "${#minimum_parts[@]}" -gt "$count" ]; then
    count="${#minimum_parts[@]}"
  fi
  for ((index = 0; index < count; index += 1)); do
    actual_part="${actual_parts[$index]:-0}"
    minimum_part="${minimum_parts[$index]:-0}"
    if ((10#$actual_part > 10#$minimum_part)); then
      return 0
    fi
    if ((10#$actual_part < 10#$minimum_part)); then
      return 1
    fi
  done
  return 0
}

write_preflight_result() {
  local result_path="$1"
  local status="COMPATIBLE"
  local error_code=""
  local reason_zh="兼容能力预检通过"
  local failed_json="[]"
  local item=""
  local tmp_path=""
  local write_status=0
  if [ -n "$TAIJI_PREFLIGHT_ERROR_CODE" ]; then
    status="BLOCKED"
    error_code="$TAIJI_PREFLIGHT_ERROR_CODE"
    reason_zh="$TAIJI_PREFLIGHT_REASON_ZH"
    failed_json="["
    for item in "${TAIJI_PREFLIGHT_FAILED_CAPABILITIES[@]}"; do
      if [ "$failed_json" != "[" ]; then
        failed_json+=","
      fi
      failed_json+="\"$item\""
    done
    failed_json+="]"
  fi
  mkdir -p "$(dirname "$result_path")"
  umask 077
  if ! tmp_path="$(mktemp -- "${result_path}.tmp.XXXXXX" 2>/dev/null)"; then
    return 1
  fi
  [ -n "$tmp_path" ] || return 1
  trap 'rm -f -- "$tmp_path"' RETURN
  if (
    umask 077
    printf '{"schema":"taiji-install-preflight/v1","status":"%s","policy_id":"%s","compatibility_policy_sha256":"%s","error_code":"%s","reason_zh":"%s","failed_capabilities":%s}\n' \
      "$status" "$TAIJI_POLICY_ID" "$TAIJI_POLICY_SHA256" "$error_code" "$reason_zh" "$failed_json" > "$tmp_path" || exit 1
    chmod 0600 "$tmp_path" || exit 1
    if command -v sync >/dev/null 2>&1; then
      sync -d "$tmp_path" 2>/dev/null || sync || exit 1
    fi
    mv -f -- "$tmp_path" "$result_path" || exit 1
  ); then
    write_status=0
  else
    write_status=$?
  fi
  if [ "$write_status" -ne 0 ]; then
    rm -f -- "$tmp_path" || true
    trap - RETURN
    return "$write_status"
  fi
  trap - RETURN
  return 0
}

verify_compatibility() {
  local os_release_input="$1"
  local actual_arch="$2"
  local actual_glibc="$3"
  local actual_kernel="$4"
  local root_prefix="$5"
  local expected_owner_uid="$6"
  local result_path="$7"
  local os_release_file=""
  local actual_id=""
  local command=""
  local desktop_dir=""
  local desktop_found=0
  local opt_path=""
  local disk_available_kib=""
  local disk_available_mib=""
  local marker=""
  local canary=""

  TAIJI_PREFLIGHT_ERROR_CODE=""
  TAIJI_PREFLIGHT_REASON_ZH=""
  TAIJI_PREFLIGHT_FAILED_CAPABILITIES=()
  os_release_file="$(root_path "$root_prefix" "$os_release_input")"

  if [ "$(id -u 2>/dev/null || printf '%s' -1)" != "$expected_owner_uid" ]; then
    preflight_block "TAIJI-LINUX-E010-PRIVILEGE" "需要管理员权限执行安装"
  fi
  case " $TAIJI_DPKG_ARCH $TAIJI_UNAME_ARCH " in
    *" $actual_arch "*) ;;
    *) preflight_block "TAIJI-LINUX-E001-ARCH" "仅支持 x86_64/amd64 架构" ;;
  esac

  actual_id="$(read_os_release_id "$os_release_file" "$root_prefix" "$expected_owner_uid" 2>/dev/null || true)"
  case " $TAIJI_OS_IDS " in
    *" $actual_id "*) ;;
    *) preflight_block "TAIJI-LINUX-E002-OS" "仅支持麒麟、统信或 openKylin 的 DEB 图形桌面系统" ;;
  esac

  for command in $TAIJI_COMMANDS; do
    if [ ! -x "$(root_path "$root_prefix" "$command")" ]; then
      case "$command" in
        */systemctl)
          preflight_block "TAIJI-LINUX-E007-SYSTEMD" "缺少 systemd/systemctl 能力"
          ;;
        *)
          preflight_block "TAIJI-LINUX-E003-DPKG" "缺少 apt/dpkg DEB 包管理能力"
          ;;
      esac
    fi
  done
  numeric_version_ge "$actual_glibc" "$TAIJI_GLIBC_MIN" || \
    preflight_block "TAIJI-LINUX-E004-GLIBC" "glibc 版本低于统一安装包最低要求"
  numeric_version_ge "$actual_kernel" "$TAIJI_KERNEL_MIN" || \
    preflight_block "TAIJI-LINUX-E005-KERNEL" "Linux 内核版本低于统一安装包最低要求"

  for desktop_dir in $TAIJI_DESKTOP_DIRS; do
    if [ -d "$(root_path "$root_prefix" "$desktop_dir")" ]; then
      desktop_found=1
      break
    fi
  done
  [ "$desktop_found" = "1" ] || \
    preflight_block "TAIJI-LINUX-E006-DESKTOP" "未检测到图形桌面会话目录"
  [ -e "$(root_path "$root_prefix" "$TAIJI_LOOPBACK_PATH")" ] || \
    preflight_block "TAIJI-LINUX-E008-LOOPBACK" "未检测到 loopback 网络接口"

  opt_path="$(root_path "$root_prefix" "$TAIJI_INSTALL_ROOT_PARENT")"
  if [ ! -d "$opt_path" ]; then
    preflight_block "TAIJI-LINUX-E009-DISK" "安装目录父路径不存在"
  else
    marker="$root_prefix/.taiji-disk-headroom-mib"
    if [ "$root_prefix" != "/" ] && [ -f "$marker" ]; then
      disk_available_mib="$(cat "$marker" 2>/dev/null || printf '%s' 0)"
      [[ "$disk_available_mib" =~ ^[0-9]+$ ]] || disk_available_mib=0
    else
      disk_available_kib="$(df -Pk "$opt_path" 2>/dev/null | awk 'NR == 2 {print $4}')"
      if [[ "$disk_available_kib" =~ ^[0-9]+$ ]]; then
        disk_available_mib=$((disk_available_kib / 1024))
      else
        disk_available_mib=0
      fi
    fi
    if [ "$disk_available_mib" -lt "$TAIJI_DISK_HEADROOM_MIB" ]; then
      preflight_block "TAIJI-LINUX-E009-DISK" "安装目录可用磁盘空间不足"
    fi
  fi

  if [ -e "$(root_path "$root_prefix" /etc/kysec)" ] || \
    [ -e "$(root_path "$root_prefix" /etc/kysec.conf)" ] || \
    [ -e "$(root_path "$root_prefix" /etc/security/kysec)" ] || \
    [ -e "$(root_path "$root_prefix" /usr/sbin/kysec)" ] || \
    [ -e "$(root_path "$root_prefix" /usr/bin/kysec)" ] || \
    [ -e "$(root_path "$root_prefix" /usr/lib/kysec)" ] || \
    [ -e "$(root_path "$root_prefix" /usr/libexec/kysec)" ]; then
    preflight_block "TAIJI-LINUX-E011-KYSEC" "检测到 Kysec 安全策略，无法保证安装目录可执行"
  fi

  if [ -e "$opt_path/.taiji-noexec" ] || [ -e "$opt_path/.noexec" ]; then
    preflight_block "TAIJI-LINUX-E012-OPT-NOEXEC" "安装目录所在文件系统启用了 noexec"
  elif [ "$root_prefix" = "/" ] && command -v findmnt >/dev/null 2>&1; then
    if findmnt -no OPTIONS --target "$opt_path" 2>/dev/null | tr ',' '\n' | grep -qx noexec; then
      preflight_block "TAIJI-LINUX-E012-OPT-NOEXEC" "安装目录所在文件系统启用了 noexec"
    fi
  fi

  if [ -d "$opt_path" ]; then
    canary="$(mktemp "$opt_path/.taiji-preflight.XXXXXX" 2>/dev/null || true)"
    if [ -z "$canary" ]; then
      preflight_block "TAIJI-LINUX-E013-SANDBOX" "安全策略阻止安装目录写入测试"
    else
      rm -f -- "$canary"
    fi
  fi

  if [ -n "$TAIJI_PREFLIGHT_ERROR_CODE" ]; then
    write_preflight_result "$result_path"
    printf '[BLOCKED] %s\n' "$TAIJI_PREFLIGHT_ERROR_CODE" >&2
    return 1
  fi
  write_preflight_result "$result_path"
  printf '[OK] Compatibility preflight passed: %s\n' "$TAIJI_POLICY_ID"
  return 0
}

if [[ "${BASH_SOURCE[0]}" != "$0" ]]; then
  return 0
fi

arch="$(dpkg --print-architecture 2>/dev/null || uname -m)"
glibc_banner="$(ldd --version 2>&1 | head -n 1)"
glibc_version="$(printf '%s\n' "$glibc_banner" | grep -Eo '[0-9]+(\.[0-9]+)+' | tail -n 1)"
kernel_version="$(uname -r)"
verify_compatibility /etc/os-release "$arch" "$glibc_version" "$kernel_version" / 0 /var/lib/taiji-agent/preflight.json
