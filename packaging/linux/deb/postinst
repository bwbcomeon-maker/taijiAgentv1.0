#!/usr/bin/env bash
set -euo pipefail
umask 027

# This maintainer script is package-only: it never invokes a package manager and never
# resolves or writes a user's HOME/XDG tree.  User data transactions are
# owned by the management-plane upgrade journal.
INSTALL_ROOT="/opt/taiji-agent"
SYSTEM_STATE_ROOT="/var/lib/taiji-agent"
SYSTEM_LOG_ROOT="/var/log/taiji-agent"
VERIFY_LOG="$SYSTEM_LOG_ROOT/postinst-verify.log"

require_regular_file() {
  local path="$1"
  [ -f "$path" ] && [ ! -L "$path" ] || {
    printf '[FAIL] required packaged file is missing or unsafe: %s\n' "$path" >&2
    return 1
  }
}

for required_script in \
  start-agent.sh \
  start-webui.sh \
  stop-all.sh \
  runtime-env.sh \
  taiji-native-verify \
  taiji-agent-diagnose \
  sync-packaged-config.py; do
  require_regular_file "$INSTALL_ROOT/scripts/$required_script"
  chmod 0755 "$INSTALL_ROOT/scripts/$required_script"
done
unset required_script

for launcher in /usr/bin/taiji-agent /usr/bin/taiji; do
  require_regular_file "$launcher"
  chmod 0755 "$launcher"
done
unset launcher

chrome_sandbox="$INSTALL_ROOT/apps/taiji-desktop/node_modules/electron/dist/chrome-sandbox"
require_regular_file "$chrome_sandbox"
chown root:root "$chrome_sandbox"
chmod 4755 "$chrome_sandbox"
sandbox_metadata="$(stat -c '%u:%g:%a' -- "$chrome_sandbox")"
[ "$sandbox_metadata" = "0:0:4755" ] || {
  printf '[FAIL] chrome-sandbox owner/mode verification failed: %s\n' "$sandbox_metadata" >&2
  exit 1
}

install -d -o root -g root -m 0750 \
  "$SYSTEM_STATE_ROOT" \
  "$SYSTEM_STATE_ROOT/runtime-home" \
  "$SYSTEM_STATE_ROOT/workspace" \
  "$SYSTEM_STATE_ROOT/tmp" \
  "$SYSTEM_LOG_ROOT"

native_verify="$INSTALL_ROOT/bin/taiji-native-verify"
require_regular_file "$native_verify"
chmod 0755 "$native_verify"
if ! env -i \
  PATH=/usr/sbin:/usr/bin:/sbin:/bin \
  LANG=C.UTF-8 \
  "$native_verify" --system-only >"$VERIFY_LOG" 2>&1; then
  printf '[FAIL] installed payload verification failed; see %s\n' "$VERIFY_LOG" >&2
  exit 1
fi
chmod 0640 "$VERIFY_LOG"

if command -v update-desktop-database >/dev/null 2>&1; then
  update-desktop-database /usr/share/applications >/dev/null 2>&1 || true
fi

if command -v gtk-update-icon-cache >/dev/null 2>&1; then
  gtk-update-icon-cache -q /usr/share/icons/hicolor >/dev/null 2>&1 || true
fi

exit 0
