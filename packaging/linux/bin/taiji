#!/bin/bash -p
# Ordinary-user Taiji Agent CLI launcher. It uses each user's product runtime
# state and does not read the desktop app's temporary API key.
set -euo pipefail

PATH="/usr/bin:/bin:/usr/sbin:/sbin"
export PATH

# Bash privileged mode prevents BASH_ENV and exported functions from running
# before this boundary. Re-exec once with every code/path selector removed so
# invalid environment names (for example BASH_FUNC_*%%) cannot cross it either.
_taiji_unset_args=()
while IFS= read -r -d '' _taiji_env_entry; do
  _taiji_env_name="${_taiji_env_entry%%=*}"
  case "$_taiji_env_name" in
    PYTHON* | NODE_* | LD_* | DYLD_* | BASH_FUNC_* | \
    BASH_ENV | ENV | SHELLOPTS | BASHOPTS | CDPATH | GLOBIGNORE | IFS | \
    PROMPT_COMMAND | RUBYOPT | RUBYLIB | PERL5OPT | PERL5LIB | \
    JAVA_TOOL_OPTIONS | CLASSPATH | LUA_PATH | LUA_CPATH | \
    ELECTRON_RUN_AS_NODE | \
    TAIJI_AGENT_ROOT | TAIJI_AGENT_AGENT_DIR | TAIJI_AGENT_WEBUI_DIR | \
    TAIJI_AGENT_PYTHON | TAIJI_WEBUI_PYTHON | TAIJI_WEBUI_AGENT_DIR | \
    TAIJI_AGENT_RUNTIME_ENV | TAIJI_AGENT_ENV_FILE | TAIJI_AGENT_HOME | \
    TAIJI_AGENT_USE_USER_DIRS | TAIJI_PYTHON | TAIJI_LAUNCH_PROFILE | \
    TAIJI_RELEASE_* | TAIJI_SOURCE_* | \
    AGENT_DIR | WEBUI_DIR | LAB_DIR | SCRIPT_DIR | RUNTIME_ENV)
      _taiji_unset_args+=("-u" "$_taiji_env_name")
      ;;
  esac
done < <(/usr/bin/env -0)
if [ "${#_taiji_unset_args[@]}" -gt 0 ]; then
  exec /usr/bin/env "${_taiji_unset_args[@]}" \
    PATH="$PATH" \
    /bin/bash --noprofile --norc -p "$0" "$@"
fi
unset _taiji_unset_args _taiji_env_entry _taiji_env_name

APP_ROOT="/opt/taiji-agent"
PRODUCT_VERSION_FILE="$APP_ROOT/VERSION"
RUNTIME_ENV="$APP_ROOT/scripts/runtime-env.sh"
TAIJI_LAUNCH_PROFILE="installed-production"
TAIJI_AGENT_ROOT="$APP_ROOT"
TAIJI_AGENT_USE_USER_DIRS="1"
export TAIJI_LAUNCH_PROFILE TAIJI_AGENT_ROOT TAIJI_AGENT_USE_USER_DIRS

print_taiji_version() {
  local product_version actual_bytes expected_bytes
  if [ ! -f "$PRODUCT_VERSION_FILE" ] || [ -L "$PRODUCT_VERSION_FILE" ] || [ ! -r "$PRODUCT_VERSION_FILE" ]; then
    echo "Taiji Agent product version identity is missing or unsafe: $PRODUCT_VERSION_FILE" >&2
    return 1
  fi
  actual_bytes="$(/usr/bin/wc -c < "$PRODUCT_VERSION_FILE" | /usr/bin/tr -d '[:space:]')"
  product_version="$(/bin/cat -- "$PRODUCT_VERSION_FILE")"
  if [[ ! "$product_version" =~ ^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$ ]]; then
    echo "Taiji Agent product version identity is invalid" >&2
    return 1
  fi
  expected_bytes=$((${#product_version} + 1))
  if [ "$actual_bytes" != "$expected_bytes" ]; then
    echo "Taiji Agent product version identity must contain one SemVer line" >&2
    return 1
  fi
  printf 'Taiji Agent %s\n' "$product_version"
}

case "${1:-}" in
  --version|-V|version)
    print_taiji_version
    exit $?
    ;;
esac

if [ ! -f "$RUNTIME_ENV" ]; then
  echo "Taiji Agent runtime environment not found: $RUNTIME_ENV" >&2
  exit 1
fi

# shellcheck source=/dev/null
source "$RUNTIME_ENV"
TAIJI_PYTHON="$TAIJI_AGENT_PYTHON"
if [ ! -x "$TAIJI_PYTHON" ]; then
  echo "Taiji Agent CLI runtime not found: $TAIJI_PYTHON" >&2
  exit 1
fi

cd "$APP_ROOT/runtime/agent"
exec "$TAIJI_PYTHON" -m taiji_runtime.main "$@"
