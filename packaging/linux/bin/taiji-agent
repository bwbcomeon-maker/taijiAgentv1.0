#!/bin/bash -p
# Open the Taiji Agent desktop app from an installed Linux package.
set -euo pipefail

PATH="/usr/bin:/bin:/usr/sbin:/sbin"
export PATH

_taiji_unset_args=()
while IFS= read -r -d '' _taiji_env_entry; do
  _taiji_env_name="${_taiji_env_entry%%=*}"
  case "$_taiji_env_name" in
    PYTHON* | NODE_* | LD_* | DYLD_* | BASH_FUNC_* | \
    BASH_ENV | ENV | SHELLOPTS | BASHOPTS | CDPATH | GLOBIGNORE | IFS | \
    PROMPT_COMMAND | RUBYOPT | RUBYLIB | PERL5OPT | PERL5LIB | \
    JAVA_TOOL_OPTIONS | CLASSPATH | LUA_PATH | LUA_CPATH | \
    ELECTRON_RUN_AS_NODE | \
    TAIJI_AGENT_ROOT | TAIJI_AGENT_AGENT_DIR | TAIJI_AGENT_WEBUI_DIR | \
    TAIJI_AGENT_PYTHON | TAIJI_WEBUI_PYTHON | TAIJI_WEBUI_AGENT_DIR | \
    TAIJI_AGENT_RUNTIME_ENV | TAIJI_AGENT_ENV_FILE | TAIJI_AGENT_HOME | \
    TAIJI_AGENT_USE_USER_DIRS | TAIJI_PYTHON | TAIJI_LAUNCH_PROFILE | \
    TAIJI_RELEASE_* | TAIJI_SOURCE_* | \
    AGENT_DIR | WEBUI_DIR | LAB_DIR | SCRIPT_DIR | RUNTIME_ENV)
      _taiji_unset_args+=("-u" "$_taiji_env_name")
      ;;
  esac
done < <(/usr/bin/env -0)
if [ "${#_taiji_unset_args[@]}" -gt 0 ]; then
  exec /usr/bin/env "${_taiji_unset_args[@]}" \
    PATH="$PATH" \
    /bin/bash --noprofile --norc -p "$0" "$@"
fi
unset _taiji_unset_args _taiji_env_entry _taiji_env_name

APP_ROOT="/opt/taiji-agent"
APP_DIR="$APP_ROOT/apps/taiji-desktop"
ELECTRON_BIN="$APP_DIR/node_modules/electron/dist/electron"

if [ ! -x "$ELECTRON_BIN" ]; then
  echo "Electron runtime not found: $ELECTRON_BIN" >&2
  echo "Rebuild the offline package on Linux x86_64 so node_modules/electron contains the Linux binary." >&2
  exit 1
fi

TAIJI_LAUNCH_PROFILE="installed-production"
TAIJI_AGENT_ROOT="$APP_ROOT"
TAIJI_AGENT_AGENT_DIR="$APP_ROOT/runtime/agent"
TAIJI_AGENT_WEBUI_DIR="$APP_ROOT/runtime/web"
TAIJI_AGENT_PYTHON="$TAIJI_AGENT_AGENT_DIR/venv/bin/python"
TAIJI_WEBUI_PYTHON="$TAIJI_AGENT_PYTHON"
TAIJI_WEBUI_AGENT_DIR="$TAIJI_AGENT_AGENT_DIR"
TAIJI_AGENT_USE_USER_DIRS="1"
export TAIJI_LAUNCH_PROFILE
export \
  TAIJI_AGENT_ROOT TAIJI_AGENT_USE_USER_DIRS \
  TAIJI_AGENT_AGENT_DIR TAIJI_AGENT_WEBUI_DIR \
  TAIJI_AGENT_PYTHON TAIJI_WEBUI_PYTHON TAIJI_WEBUI_AGENT_DIR
exec "$ELECTRON_BIN" "$APP_DIR"
